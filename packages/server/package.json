    "dev": "node --watch --import tsx src/index.ts"
  },
  "dependencies": {
    "@wb/shared": "*",
    "pg": "^8.13.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.12",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
